#!/bin/bash
# rig:summary=Switch the ASUS discrete GPU mode without a logout or reboot
# rig:usage=rig gpu mode [hybrid|integrated]

set -euo pipefail

target="${1:-}"
case "$target" in
  hybrid|integrated) ;;
  *)
    echo "usage: rig gpu mode [hybrid|integrated]" >&2
    exit 1
    ;;
esac

if ! command -v supergfxctl >/dev/null 2>&1; then
  echo "supergfxctl is not installed" >&2
  exit 1
fi

config=/etc/supergfxd.conf
if [[ ! -f "$config" ]]; then
  echo "$config not found" >&2
  exit 1
fi

gpu_on_bus() {
  grep -lq '^0x10de' /sys/bus/pci/devices/*/vendor 2>/dev/null
}

current=$(supergfxctl -g 2>/dev/null || echo "")
if [[ ${current,,} == "$target" ]] &&
  { [[ $target == "integrated" ]] || gpu_on_bus; }; then
  echo "GPU mode is already $current"
  exit 0
fi

# supergfxctl waits for the graphical session to end before it touches the
# GPU, and that wait is capped at 30 seconds upstream. A request from inside
# the session therefore fails and leaves the GPU detached. The setting below
# removes the wait.
if ! grep -q '"no_logind": true' "$config"; then
  echo "Disabling the supergfxctl login wait"
  sudo sed -i -E 's/"no_logind": (true|false)/"no_logind": true/' "$config"
fi

# Save the mode first. The daemon reads it at startup, so a reboot applies it
# through the boot path even when the live switch below cannot run.
sudo sed -i -E "s/\"mode\": \"[A-Za-z]+\"/\"mode\": \"${target^}\"/" "$config"

# The daemon learns which GPU it controls only when it starts. If it starts
# while the discrete GPU is detached, it sees no GPU, reports only Integrated
# as supported, and rejects Hybrid. The device must be on the bus first.
if [[ $target == "hybrid" ]] && ! gpu_on_bus; then
  echo "Rescanning the PCI bus for the discrete GPU"
  echo 1 | sudo tee /sys/bus/pci/rescan >/dev/null
  sleep 2

  if ! gpu_on_bus; then
    echo "The discrete GPU is not on the PCI bus and a rescan cannot restore it." >&2
    echo "The mode is saved as $target. Reboot to apply it." >&2
    exit 1
  fi
fi

echo "Setting the GPU mode to $target"
sudo systemctl restart supergfxd

for _ in $(seq 1 30); do
  sleep 1
  mode=$(supergfxctl -g 2>/dev/null || echo "")
  if [[ ${mode,,} == "$target" ]]; then
    echo "GPU mode: $mode"
    break
  fi
done

if [[ ${mode,,} != "$target" ]]; then
  echo "The GPU mode switch did not complete" >&2
  echo "Check the daemon log with: journalctl -u supergfxd -n 50" >&2
  exit 1
fi

if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
  nvidia-smi --query-gpu=name --format=csv,noheader
fi
