{
  "system": {
    "hostname": "pixw"
  },
  "llama": {
    "model": ["unsloth/Qwen3-1.7B-GGUF:Q4_K_M", "ggml-org/gemma-4-E4B-it-GGUF:Q4_0"],
    "host": "127.0.0.1",
    "port": 8080,
    "system_prompt_file": "~/.local/share/llama.cpp/system-prompt.md",
    "server_args": ["-c", "4096", "-np", "1"]
  },
  "nextdns": {
    "config_id": ""
  },
  "dnf": {
    "max_parallel_downloads": 10,
    "install_weak_deps": false,
    "fastestmirror": true
  },
  "skills": {
    "skills_source": "$HOME/dev/tools/skillset/skills",
    "commands_source": "$HOME/dev/tools/skillset/commands"
  },
  "repositories": {
    "rpmfusion": {
      "enabled": true
    },
    "terra": {
      "enabled": true
    },
    "copr": {
      "repos": [
        "atim/starship",
        "lilay/topgrade",
        "lukenukem/asus-linux",
        "scottames/ghostty",
        "sneed/llama-cpp-vulkan",
        "sureclaw/opencode"
      ]
    },
    "external": [
      {
        "name": "vscode",
        "type": "repo_file",
        "content": "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\nautorefresh=1\ntype=rpm-md\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc",
        "gpgkey": "https://packages.microsoft.com/keys/microsoft.asc"
      },
      {
        "name": "tailscale",
        "type": "url",
        "repo_url": "https://pkgs.tailscale.com/stable/fedora/tailscale.repo"
      }
    ]
  },
  "services": {
    "enable": [
      "docker.service",
      "postgresql.service",
      "redis.service",
      "tailscaled.service"
    ],
    "disable": ["cups.service", "NetworkManager-wait-online.service"]
  },
  "hardware": {
    "asus": {
      "auto_detect": true,
      "packages": ["asusctl", "supergfxctl"]
    },
    "nvidia": {
      "auto_detect": true
    }
  },
  "multimedia": {
    "install_codecs": true,
    "enable_hardware_accel": true,
    "swap_to_full_ffmpeg": true
  },
  "flatpak": {
    "bitwarden_secure_memory_backend": "mlock"
  },
  "fonts": {
    "nerd_fonts_version": "v3.5.0",
    "redhat_font_version": "5.0.0"
  },
  "performance": {
    "enable_zram": true,
    "zram_size_mb": 24576,
    "disable_cpu_mitigations": false,
    "enable_fstrim": true,
    "enable_oomd": true,
    "grub_timeout": 1,
    "auto_luks": true,
    "shut_off_time": 20,
    "swappiness": 150,
    "enable_hibernation": true,
    "hibernation_swap_size_mb": 16384,
    "hibernation_delay": "30min"
  },
  "secureboot": {
    "enabled": false
  },
  "git": {
    "user_name": "PiX",
    "user_email": "69745008+pixincreate@users.noreply.github.com"
  },
  "directories": {
    "config": "~/.config",
    "local_bin": "~/.local/bin",
    "ssh": "~/.ssh",
    "fonts": "~/.local/share/fonts",
    "wallpapers": "~/Pictures/Wallpapers",
    "screenshots": "~/Pictures/Screenshots",
    "zsh": "~/.zsh",
    "npm_global": "~/.npm-global"
  },
  "dotfiles": {
    "stow_source": "~/dev/.dotfiles/home",
    "stow_packages": [
      "cargo",
      "config",
      "ssh",
      "zsh",
      "Pictures",
      "local",
      "pi"
    ],
    "config_root": "~/dev/.rig"
  }
}
