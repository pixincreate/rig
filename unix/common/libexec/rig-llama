#!/bin/bash
# rig:summary=Convenience wrapper for llama.cpp server/chat
# rig:usage=rig llama [server|chat|list|pull] [args]

set -euo pipefail

RIG_PATH="${RIG_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"

models_dir="${LLAMA_MODELS_DIR:-$HOME/.local/share/llama.cpp/models}"
mkdir -p "$models_dir"

if [[ -z ${RIG_PLATFORM:-} ]]; then
  RIG_PLATFORM=$(uname -s | grep -q Darwin && echo macos || echo fedora)
fi
config_file="$RIG_PATH/unix/$RIG_PLATFORM/config.json"

cfg() {
  command -v jq &>/dev/null || return 0
  [[ -f "$config_file" ]] || return 0
  jq -r "$1 // empty" "$config_file" 2>/dev/null
}

# Default llama-server flags from .llama.server_args (array, optional)
cfg_server_args() {
  command -v jq &>/dev/null || return 0
  [[ -f "$config_file" ]] || return 0
  jq -r '(.llama.server_args // [])[]?' "$config_file" 2>/dev/null
}

# Ordered model chain from .llama.model. An array is walked in order; a bare
# string is accepted as a one-entry chain so an older config keeps working.
cfg_models() {
  command -v jq &>/dev/null || return 0
  [[ -f "$config_file" ]] || return 0
  jq -r '(.llama.model // empty) | if type == "array" then .[] else . end' "$config_file" 2>/dev/null
}

resolved_model=""
resolved_is_hf=false

# llama.cpp caches remote models under this layout, so a cached repo needs no
# network check and stays usable offline.
hf_cache_dir() {
  local repo="${1%%:*}"
  echo "${XDG_CACHE_HOME:-$HOME/.cache}/huggingface/hub/models--${repo//\//--}"
}

hf_model_available() {
  local ref="$1"
  local cache
  cache=$(hf_cache_dir "$ref")

  if [[ -d "$cache/snapshots" ]] \
    && find "$cache/snapshots" -mindepth 2 -maxdepth 2 -type f -print -quit 2>/dev/null | grep -q .; then
    return 0
  fi

  # Without curl, do not reject every remote model just because we cannot probe.
  command -v curl &>/dev/null || return 0

  local -a probe=(--silent --fail --location --max-time 10 --output /dev/null)
  if [[ -n ${HF_TOKEN:-} ]]; then
    probe+=(--header "Authorization: Bearer $HF_TOKEN")
  fi
  curl "${probe[@]}" "https://huggingface.co/api/models/${ref%%:*}" &>/dev/null
}

# Sets resolved_model/resolved_is_hf. Returns 1 when the entry is unusable.
resolve_candidate() {
  local model="$1"
  resolved_is_hf=false

  if [[ $model == /* && -f "$model" ]]; then
    resolved_model="$model"
    return 0
  fi
  if [[ $model != /* && -f "$models_dir/$model" ]]; then
    resolved_model="$models_dir/$model"
    return 0
  fi

  # Anything else containing a slash is a Hugging Face ref (repo or repo:quant)
  if [[ $model == */* ]] && hf_model_available "$model"; then
    resolved_model="$model"
    resolved_is_hf=true
    return 0
  fi

  return 1
}

resolve_model() {
  local requested="${1:-}"

  # An explicit argument names one model. It is not a chain: resolve or fail.
  if [[ -n $requested ]]; then
    if resolve_candidate "$requested"; then
      return 0
    fi
    echo "[ERROR] Model not found or unavailable: $requested"
    return 1
  fi

  local -a chain=()
  local model
  while IFS= read -r model; do
    if [[ -n $model ]]; then
      chain+=("$model")
    fi
  done < <(cfg_models)

  if [[ ${#chain[@]} -eq 0 ]]; then
    echo "[ERROR] No model given and .llama.model is not set in $config_file"
    return 1
  fi

  for model in "${chain[@]}"; do
    if resolve_candidate "$model"; then
      return 0
    fi
    echo "[WARN] Skipping unusable model: $model" >&2
  done

  echo "[ERROR] No usable model in .llama.model ($config_file)" >&2
  return 1
}

usage() {
  echo "Usage: rig llama <command> [args]"
  echo ""
  echo "Commands:"
  echo "  server [model] [flags]   Start llama-server (default: .llama.model from config.json)"
  echo "                           If .llama.system_prompt_file exists, serves through the"
  echo "                           rig-llama-proxy so it is injected before harness prompts."
  echo "                           .llama.server_args from config.json is applied first;"
  echo "                           flags you pass here come last and win."
  echo "  chat [model] [flags]     Start llama-cli in interactive chat mode"
  echo "  list             Show the configured model chain and downloaded models"
  echo "  pull <url>       Download a model into $models_dir"
  echo ""
  echo "Model can be a file in $models_dir, an absolute path, or a Hugging Face ref"
  echo "like ggml-org/gemma-4-E4B-it-GGUF:Q4_0 (downloaded and cached by llama.cpp)."
  echo "Put the model before any flag: rig llama server model.gguf -ngl 20."
  echo "Put .llama.server_args from config.json to make flags permanent."
  echo ""
  echo "With no model argument, .llama.model is an ordered chain. Each entry is"
  echo "tried in order and the first usable one wins; unusable entries are"
  echo "skipped with a warning. rig llama list shows the chain."
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage
fi

command="$1"
shift

# The model is the first bare argument, and it must come before any flag.
# Everything from the first flag onward is forwarded verbatim, so flags that
# take a separate value (-ngl 20, -c 4096) keep their value instead of having
# it mistaken for the model. Use --model to pass a model alongside flags.
model_arg=""
extra_args=()
seen_flag=false
for arg in "$@"; do
  if [[ $arg == -* ]]; then
    seen_flag=true
    extra_args+=("$arg")
  elif [[ $seen_flag == false && -z $model_arg ]]; then
    model_arg="$arg"
  else
    extra_args+=("$arg")
  fi
done

case "$command" in
  server)
    resolve_model "$model_arg" || exit 1
    host="$(cfg ".llama.host")"
    port="$(cfg ".llama.port")"
    [[ -n $host ]] || host="127.0.0.1"
    [[ -n $port ]] || port=8080

    server_cmd=(llama-server)
    if [[ $resolved_is_hf == true ]]; then
      echo "Starting llama-server on $resolved_model (Hugging Face)"
      server_cmd+=(-hf "$resolved_model")
    else
      echo "Starting llama-server on $resolved_model"
      server_cmd+=(--model "$resolved_model")
    fi

    # Base system prompt: when configured, a proxy prepends it ahead of every
    # request so harnesses (opencode/pi/...) get vendor-style prompt injection.
    prompt_file="$(cfg ".llama.system_prompt_file")"
    listen_port=$port
    proxy_pid=""
    if [[ -n $prompt_file ]]; then
      prompt_file="${prompt_file/#\~/$HOME}"
      if [[ -f $prompt_file ]]; then
        (( internal = port + 1 ))
        listen_port=$internal
        echo "Base system prompt ON: $prompt_file"
        python3 "$RIG_PATH/unix/common/libexec/rig-llama-proxy" \
          --listen "$port" --upstream "127.0.0.1:$internal" --prompt-file "$prompt_file" &
        proxy_pid=$!
      else
        echo "[WARN] .llama.system_prompt_file not found, serving without it: $prompt_file"
      fi
    fi

    server_args=()
    while IFS= read -r arg; do
      if [[ -n $arg ]]; then
        server_args+=("$arg")
      fi
    done < <(cfg_server_args)

    # Config flags first, CLI flags last: llama-server takes the last value
    # for scalar options, so an explicit flag always overrides the config.
    server_cmd+=(--host "$host" --port "$listen_port" \
      ${server_args[@]+"${server_args[@]}"} ${extra_args[@]+"${extra_args[@]}"})

    if [[ -n $proxy_pid ]]; then
      echo "Harnesses connect to http://$host:$port/v1 (llama-server binds 127.0.0.1:$internal)"
      "${server_cmd[@]}" &
      srv_pid=$!
      trap 'kill "$srv_pid" "$proxy_pid" 2>/dev/null' EXIT INT TERM
      wait "$srv_pid"
    else
      exec "${server_cmd[@]}"
    fi
    ;;

  chat)
    resolve_model "$model_arg" || exit 1
    if [[ $resolved_is_hf == true ]]; then
      echo "Starting llama-cli chat on $resolved_model (Hugging Face)"
      exec llama-cli -hf "$resolved_model" --interactive ${extra_args[@]+"${extra_args[@]}"}
    fi
    echo "Starting llama-cli chat on $resolved_model"
    exec llama-cli --model "$resolved_model" --interactive ${extra_args[@]+"${extra_args[@]}"}
    ;;

  list)
    echo "Configured chain (.llama.model in $config_file):"
    listed=0
    while IFS= read -r model; do
      if [[ -n $model ]]; then
        echo "  $model"
        listed=$((listed + 1))
      fi
    done < <(cfg_models)
    if ((listed == 0)); then
      echo "  (none)"
    fi

    echo ""
    echo "Downloaded models in $models_dir:"
    listed=0
    while IFS= read -r path; do
      if [[ -n $path ]]; then
        echo "  $(basename "$path")"
        listed=$((listed + 1))
      fi
    done < <(find "$models_dir" -maxdepth 1 -type f -name "*.gguf" 2>/dev/null)
    if ((listed == 0)); then
      echo "  (none)"
    fi
    ;;

  pull)
    url="${1:-}"
    if [[ -z $url ]]; then
      echo "[ERROR] No URL specified"
      usage
    fi
    filename=$(basename "$url")
    curl --location --progress-bar --continue-at - "$url" --output "$models_dir/$filename"
    echo "[SUCCESS] Downloaded $models_dir/$filename"
    ;;

  *)
    usage
    ;;
esac
